{
  "name": "support-intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "files": [
    "app",
    "public",
    "ml/*.py",
    "ml/requirements.txt",
    "README.md"
  ],
  "scripts": {
    "start": "node app/start.mjs",
    "migrate": "node app/start.mjs --migrate-only",
    "test": "node --test test/validation.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:browser": "cucumber-js --import test/steps.mjs test/intake.feature",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "embedded-postgres": "17.12.0-beta.19",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.2.0",
    "selenium-webdriver": "4.38.0"
  }
}
